# Copie para .env somente no computador que executa o servidor.
# Use uma chave nova. Nunca envie o arquivo .env junto com o projeto.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
PORT=4173
MYSQL_LOCAL=false
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=yena
MYSQL_USER=yena_app
MYSQL_PASSWORD=
MYSQL_SSL=false
YENA_ADMIN_USER=admin
YENA_ADMIN_PASSWORD=
# Para hospedagem Node.js com proxy HTTPS:
# HOST=0.0.0.0
# APP_ORIGIN=https://seu-dominio.example
